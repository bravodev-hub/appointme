  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "preferNameDirectory": true,
  "sources": [
    {
      "source": "./",
      "target": "./",
      "modifiers": [
        {
          "exclude": [
            "templates/**",
            "artifacts/**",
            "**/bin/**",
            "**/obj/**",
            "**/node_modules/**",
            "**/dist/**"
          ]
        }
      ]
    }
  ]
}

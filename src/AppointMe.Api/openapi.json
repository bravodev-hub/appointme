  "components": {
    "schemas": {
      "AppointmentDto": {
        "required": [
          "id",
          "start",
          "end",
          "status",
          "providerId",
          "attendeeId",
          "scheduledAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "start": {
            "type": "string",
            "format": "date-time"
          },
          "end": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "$ref": "#/components/schemas/AppointmentStatus"
          },
          "providerId": {
            "type": "string",
            "format": "uuid"
          },
          "providerFirstName": {
            "type": [
              "null",
              "string"
            ]
          },
          "providerLastName": {
            "type": [
              "null",
              "string"
            ]
          },
          "providerName": {
            "type": [
              "null",
              "string"
            ]
          },
          "providerInitials": {
            "type": [
              "null",
              "string"
            ]
          },
          "attendeeId": {
            "type": "string",
            "format": "uuid"
          },
          "attendeeFirstName": {
            "type": [
              "null",
              "string"
            ]
          },
          "attendeeLastName": {
            "type": [
              "null",
              "string"
            ]
          },
          "attendeeName": {
            "type": [
              "null",
              "string"
            ]
          },
          "attendeeInitials": {
            "type": [
              "null",
              "string"
            ]
          },
          "notes": {
            "type": [
              "null",
              "string"
            ]
          },
          "scheduledAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "AppointmentStatus": {
        "enum": [
          "Scheduled",
          "Cancelled"
        ]
      },
      "CompanyMembership": {
        "required": [
          "companyId",
          "companyName",
          "timeZone"
        ],
        "type": "object",
        "properties": {
          "companyId": {
            "type": "string",
            "format": "uuid"
          },
          "companyName": {
            "type": "string"
          },
          "timeZone": {
            "type": "string"
          }
        }
      },
      "CustomerDto": {
        "required": [
          "id",
          "fullName",
          "firstName",
          "initials",
          "registrationDate"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "fullName": {
            "type": "string"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": [
              "null",
              "string"
            ]
          },
          "initials": {
            "type": "string"
          },
          "dateOfBirth": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          },
          "gender": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Gender"
              }
            ]
          },
          "email": {
            "type": [
              "null",
              "string"
            ]
          },
          "registrationDate": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Gender": {
        "enum": [
          "Male",
          "Female",
          "Other",
          null
        ]
      },
      "GetCurrentUserAccessResponse": {
        "required": [
          "companyId",
          "roles",
          "permissions"
        ],
        "type": "object",
        "properties": {
          "companyId": {
